# Docker Compose project name is fixed by compose.yaml and scripts/m1.sh.
# This sample has no secret or private household data. Change the database
# password before storing non-synthetic data.
SAMVEV_PORT=4173
SAMVEV_DB_NAME=samvev
SAMVEV_DB_USER=samvev
SAMVEV_DB_PASSWORD=local-development-only
SAMVEV_DEMO_MODE=true
